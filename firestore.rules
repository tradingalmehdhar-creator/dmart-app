rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Customer Users collection
    match /dmart_users/{userId} {
      allow read, write: if true; // Allows demo & guest browsing with full sync, or isOwner(userId)
    }

    // Merchant Partners / Suppliers
    match /dmart_suppliers/{supplierId} {
      allow read, write: if true; // Managed by store admins & interactive UI controls
    }

    // Catalog Products Collection (Inventory, pricing, and dynamic availability sync)
    match /dmart_products/{productId} {
      allow read, write: if true; // Real-time catalog sync between storefront & admin
    }

    // Supermarket Categories Collection
    match /dmart_categories/{categoryId} {
      allow read, write: if true; // Publicly readable for customer storefront and editable by admin
    }

    // Orders Collection
    match /dmart_orders/{orderId} {
      allow read, write: if true; // Customer order placement & Rider delivery OTP verification
    }

    // Riders Collection
    match /dmart_riders/{riderId} {
      allow read, write: if true; // Rider registration, profile edits, and default landing preferences
    }

    // Customer Loyalty Points Transactions Collection
    match /dmart_loyalty_transactions/{transactionId} {
      allow read, write: if true; // Real-time earned/spent points history and cashback journal
    }

    // Storefront Banners Collections (Real-time client listener & Admin management)
    match /storefront_banners/{bannerId} {
      allow read, write: if true;
    }
    match /banners/{bannerId} {
      allow read, write: if true;
    }

    // Payout Requests Collection (Delivery Riders Daily Payouts & Admin Audit)
    match /payout_requests/{payoutId} {
      allow read, write: if true;
    }

    // Rider Ledgers Collection (Real-time Rider Financial Accounts & Statements)
    match /rider_ledgers/{ledgerId} {
      allow read, write: if true;
    }

    // System Settings & Global Configurations (PDF & Statement Settings)
    match /system_settings/{settingId} {
      allow read, write: if true;
    }

    // Push Notification Device Tokens (Firebase Cloud Messaging)
    match /dmart_fcm_tokens/{tokenId} {
      allow read, write: if true;
    }

    // Partner Orders Collection (Payout Ledger Testing & Settlements)
    match /orders/{orderId} {
      allow read, write: if true;
    }

    // Partner Payout Ledger Summaries (Settlements & Commission Audits)
    match /payout_ledger/{ledgerId} {
      allow read, write: if true;
    }
  }
}
